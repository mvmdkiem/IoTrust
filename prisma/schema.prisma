generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // 필요 시 postgresql 등으로 변경
  url      = "file:./orders.db"
}

model User {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  orders Order[]
}

model Order {
  id        Int    @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int
  user      User   @relation(fields: [userId], references: [id])

  @@index([userId])
}
